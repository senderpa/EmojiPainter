{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": false,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["react", "react-native", "jest"]
  },
  "include": ["src", "examples"],
  "exclude": ["node_modules", "babel.config.js", "metro.config.js", "src/**/__tests__/**", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
