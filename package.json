{
  "name": "emojipaint-mobile",
  "version": "1.0.0",
  "description": "A creative painting platform for real-time mobile painting, AR/spatial painting, vector drawing, and animation.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/senderpa/EmojiPainter.git"
  },
  "homepage": "https://emojipainter.com",
  "private": false,
  "main": "index.js",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "start": "expo start",
    "start:prod": "expo start --no-dev --minify",
    "gen:icons": "ts-node scripts/generate-icons.ts",
    "gen:logos": "node scripts/generate-logo-manifest.js",
    "ios": "expo run:ios",
    "ios:release": "expo run:ios --configuration Release",
    "android": "expo run:android",
    "android:release": "expo run:android --variant release",
    "build": "expo run:ios --configuration Release",
    "build:device": "expo run:ios --configuration Release --device",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --bail",
    "postprebuild": "node scripts/post-prebuild.js",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/slider": "5.0.1",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.26",
    "@sentry/react-native": "^8.13.0",
    "@shopify/react-native-skia": "2.2.12",
    "babel-preset-expo": "~54.0.9",
    "emojibase-data": "^16.0.3",
    "emojispray-bridge": "file:modules/emojispray-bridge",
    "expo": "~54.0.31",
    "expo-asset": "~12.0.12",
    "expo-av": "~16.0.7",
    "expo-blur": "~15.0.8",
    "expo-crypto": "~15.0.7",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.15",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-localization": "~17.0.8",
    "expo-mail-composer": "~15.0.8",
    "expo-media-library": "~18.2.0",
    "expo-network": "^8.0.8",
    "expo-notifications": "^0.30.7",
    "expo-screen-orientation": "~9.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.7",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "expo-video-thumbnails": "~10.0.8",
    "js-sha256": "^0.11.1",
    "jszip": "^3.10.1",
    "nanoid": "^5.1.6",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-image-resizer": "^1.4.5",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-view-shot": "^4.0.3",
    "react-native-webview": "^13.15.0",
    "react-native-worklets": "^0.5.1",
    "react-native-zoom-toolkit": "5.0.1",
    "screen-recorder": "file:modules/screen-recorder",
    "emoji-ar": "file:modules/emoji-ar",
    "metal-paint": "file:modules/metal-paint"
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.4.2",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.19.24",
    "@types/react": "~19.1.0",
    "@types/react-native": "0.73.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "eslint-config-universe": "^12.0.1",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jest-expo": "^50.0.1",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.1.0",
    "sharp": "^0.33.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "expo": {
    "autolinking": {
      "searchPaths": [
        "./modules"
      ]
    }
  }
}
